# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Postgres ---
POSTGRES_DB=neyla
POSTGRES_USER=neyla
POSTGRES_PASSWORD=neyla
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# prefer (dev, fallback non-TLS) | require (Postgres managé, ex. DO App Platform)
POSTGRES_SSLMODE=prefer

# --- Redis ---
# Local : redis://...  | Managé (DO App Platform) : rediss://... (TLS auto-géré)
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL_INTERNAL=http://api:8000
FRONTEND_URL=http://localhost:3000

# --- Email (dev = console backend, prod = SMTP à configurer) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@neyla.tv

# --- Streamers ---
# Nombre max d'approbations de candidatures streamer par jour (maîtrise des coûts).
STREAMER_DAILY_APPROVAL_QUOTA=100

# --- Monétisation "Aura" (devise = FCFA / XOF) ---
AURA_UNIT_PRICE_XOF=5
EUR_XOF_RATE=655.957
USD_XOF_RATE=600
CREATOR_SHARE=0.70
# fake (défaut, confirme tout de suite, aucune clé) | stripe | mobile_money
PAYMENTS_PROVIDER=fake
# Paiements simulés (fake, Wave/Orange Money sans clé) : 1 en dev/démo, 0 en prod réelle.
PAYMENTS_ALLOW_FAKE=1
# Frais de traitement d'un retrait (0.03 = 3 %), retrait et tip minimums (Aura).
WITHDRAWAL_PROCESSING_FEE_PCT=0.03
WITHDRAWAL_MIN_AURA=1000
TIP_MIN_AURA=10
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Uploads médias (Cloudflare R2, S3-compatible) ---
# Vide = mode FAKE (URL fake.local). Pour activer : créer un bucket R2 + clés S3.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# --- Bunny Stream (live + vidéos « Instant ») ---
# 1. LIBRARY_ID : Bunny → Stream → ta Video Library → API (« Video Library ID »).
# 2. API_KEY    : même page, « API Key » (AccessKey de la bibliothèque). SECRET.
# 3. CDN_HOSTNAME : même page, « CDN Hostname » (vz-xxxxxxxx-xxx.b-cdn.net).
# 4. WEBHOOK_KEY : clé de vérification de X-BunnyStream-Signature
#    (« Read-Only API Key » de la bibliothèque). Webhook à déclarer côté Bunny :
#    https://<domaine>/api/webhooks/bunny/stream
# 5. RTMP_URL (optionnel) : surcharge de l'URL d'ingest si l'API ne la renvoie pas.
# Laisser BUNNY_STREAM_API_KEY vide en dev pour activer le mode FAKE
# (aucun appel réseau, flux HLS public de test pour la démo).
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_WEBHOOK_KEY=dev-webhook-key
BUNNY_STREAM_RTMP_URL=
# Fréquence (s) de synchronisation live/offline par polling Bunny (Celery beat).
STREAM_STATUS_POLL_SECONDS=20

# --- Production seulement ---
# Sentry (laisser vide en dev) :
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backups Postgres → DigitalOcean Spaces (S3-compatible) :
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUPS_BUCKET=neyla-backups
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
